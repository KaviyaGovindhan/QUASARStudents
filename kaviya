# Import functions from manufacturing_utils.py
from manufacturing_utils import calculate_total_cost, calculate_defect_percentage


# 1. DATA STRUCTURES

production = [
    (501, "Circuit Board", 100, 5, 250),
    (502, "Power Supply", 80, 12, 400),
    (503, "Sensor", 150, 8, 180),
    (504, "Controller", 60, 3, 650),
    (505, "Connecter", 200, 15, 50)
]

print("\nPRODUCTION RECORDS")

for batch in production:
    print(batch)


# 2. ADD NEW PRODUCTION BATCH

print("\nADD NEW BATCH")

try:
    batch_id = int(input("Enter Batch ID: "))
    name = input("Enter Product Name: ")
    units = int(input("Enter Units Produced: "))
    defects = int(input("Enter Defective Units: "))
    cost = float(input("Enter Cost Per Unit: "))

    if units < 0 or defects < 0 or cost < 0:
        raise ValueError("Negative values are not allowed")

    if defects > units:
        raise ValueError("Defective units cannot exceed production")

    if batch_id < 0:
        raise ValueError("Batch ID cannot be negative")

    new_batch = (batch_id, name, units, defects, cost)
    production.append(new_batch)

except ValueError as e:
    print("Invalid Input:", e)

else:
    print("Batch Added Successfully!")

finally:
    print("Batch Entry Completed")


# 3. FUNCTIONS

total_cost = calculate_total_cost(production)

defect_percentage = calculate_defect_percentage(production)

print("\nTOTAL MANUFACTURING COST:", total_cost)

print("OVERALL DEFECT PERCENTAGE:",
      round(defect_percentage, 2), "%")


# 4. FILTER()

high_defect = list(
    filter(lambda batch: batch[3] > 10, production)
)

print("\nBATCHES WITH MORE THAN 10 DEFECTS")

for batch in high_defect:
    print(batch)


# 5. MAP()

accepted_quantity = list(
    map(lambda batch: batch[2] - batch[3], production)
)

print("\nACCEPTED PRODUCTION QUANTITIES")

print(accepted_quantity)


# 6. LAMBDA()

batch_cost = list(
    map(lambda batch: batch[2] * batch[4], production)
)

print("\nMANUFACTURING COST OF EACH BATCH")

print(batch_cost)


# 7. FINAL SUMMARY

print("\nFINAL SUMMARY")

print("Total Batches:", len(production))

print("Total Units:", sum(batch[2] for batch in production))

print("Accepted Units:", sum(accepted_quantity))

print("Defective Units:", sum(batch[3] for batch in production))

print("Total Cost:", total_cost)

print("Defect Percentage:", round(defect_percentage, 2), "%")
